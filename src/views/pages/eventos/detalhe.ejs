<%- include('../../partials/header', { title }) %>

<% if (msg) { %>
  <div class="alert alert-success"><%= msg %></div>
<% } %>
<% if (erro) { %>
  <div class="alert alert-danger"><%= erro %></div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-0"><%= evento.nome %></h1>
    <div class="mt-2">
      <span class="badge text-bg-secondary"><%= statusLabel[evento.status] %></span>
      <span class="text-muted ms-2"><%= evento.data_inicio %> → <%= evento.data_fim %></span>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a href="/eventos/<%= evento.id %>/editar" class="btn btn-outline-secondary">Editar</a>
    <% if (evento.status === 'planejado') { %>
      <form method="POST" action="/eventos/<%= evento.id %>/status" class="d-inline">
        <input type="hidden" name="status" value="em_andamento">
        <button type="submit" class="btn btn-outline-primary">Iniciar evento</button>
      </form>
    <% } %>
    <% if (evento.status === 'em_andamento') { %>
      <form method="POST" action="/eventos/<%= evento.id %>/status" class="d-inline">
        <input type="hidden" name="status" value="encerrado">
        <button type="submit" class="btn btn-outline-warning">Encerrar evento</button>
      </form>
    <% } %>
    <form method="POST" action="/eventos/<%= evento.id %>/excluir" class="d-inline"
          onsubmit="return confirm('Excluir este evento? Esta ação não pode ser desfeita.');">
      <button type="submit" class="btn btn-outline-danger">Excluir</button>
    </form>
  </div>
</div>

<% if (evento.status !== 'encerrado') { %>
  <div class="card mb-4">
    <div class="card-header"><strong>Sorteio do próximo adversário</strong></div>
    <div class="card-body">
      <% if (jogadores.length < 2) { %>
        <p class="text-muted mb-0">Cadastre ao menos 2 jogadores para sortear o próximo adversário.</p>
      <% } else { %>
        <form method="GET" action="/eventos/<%= evento.id %>/sorteio" class="row g-2 align-items-end">
          <div class="col-md-6">
            <label for="vencedor_id" class="form-label">Quem está na mesa (vencedor atual)</label>
            <select class="form-select" id="vencedor_id" name="vencedor_id" required>
              <option value="">Selecione...</option>
              <% jogadores.forEach((j) => { %>
                <option value="<%= j.id %>" <%= typeof sorteio !== 'undefined' && sorteio && sorteio.vencedor && sorteio.vencedor.id === j.id ? 'selected' : '' %>>
                  <%= j.nome %><%= j.apelido ? ' (' + j.apelido + ')' : '' %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <button type="submit" class="btn btn-outline-primary">🎲 Sortear adversário</button>
          </div>
        </form>

        <% if (sorteio && sorteio.semOponente) { %>
          <div class="alert alert-warning mt-3 mb-0">
            <%= sorteio.vencedor.nome %> é o único jogador ativo do evento. Não há adversários para sortear.
          </div>
        <% } else if (sorteio && sorteio.sugestao) { %>
          <div class="alert alert-success mt-3 mb-0 d-flex justify-content-between align-items-center">
            <span>
              Próximo confronto sugerido: <strong><%= sorteio.vencedor.nome %></strong> ×
              <strong><%= sorteio.sugestao.nome %></strong>
              <% if (sorteio.ultimoAdversario) { %>
                <br><small class="text-muted">Último adversário de <%= sorteio.vencedor.nome %>: <%= sorteio.ultimoAdversarioNome %></small>
              <% } %>
            </span>
            <a class="btn btn-sm btn-success" href="/eventos/<%= evento.id %>/partidas/novo?jogador_a_id=<%= sorteio.vencedor.id %>&jogador_b_id=<%= sorteio.sugestao.id %>">
              Registrar partida
            </a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-header"><strong>Ranking</strong></div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped align-middle mb-0">
        <thead>
          <tr>
            <th class="text-center" style="width:60px">#</th>
            <th>Jogador</th>
            <th class="text-center">Jogos</th>
            <th class="text-center">Vitórias</th>
            <th class="text-center">Derrotas</th>
            <th class="text-center">Aproveitamento</th>
          </tr>
        </thead>
        <tbody>
          <% ranking.forEach((r) => { %>
            <tr>
              <td class="text-center"><strong><%= r.posicao %></strong></td>
              <td><%= r.jogador.nome %><% if (r.jogador.apelido) { %> <span class="text-muted">(<%= r.jogador.apelido %>)</span><% } %></td>
              <td class="text-center"><%= r.jogos %></td>
              <td class="text-center text-success fw-bold"><%= r.vitorias %></td>
              <td class="text-center text-danger"><%= r.derrotas %></td>
              <td class="text-center"><%= r.aproveitamento %>%</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Jogadores</strong>
        <a href="/eventos/<%= evento.id %>/jogadores/novo" class="btn btn-sm btn-primary">+ Jogador</a>
      </div>
      <div class="card-body">
        <% if (jogadores.length === 0) { %>
          <p class="text-muted mb-0">Nenhum jogador cadastrado neste evento.</p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% jogadores.forEach((j) => { %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <%= j.nome %><% if (j.apelido) { %> <span class="text-muted">(<%= j.apelido %>)</span><% } %>
                <span>
                  <a href="/eventos/<%= evento.id %>/jogadores/<%= j.id %>/editar" class="btn btn-sm btn-outline-secondary">Editar</a>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Partidas</strong>
        <a href="/eventos/<%= evento.id %>/partidas/novo" class="btn btn-sm btn-primary">+ Partida</a>
      </div>
      <div class="card-body">
        <% if (partidas.length === 0) { %>
          <p class="text-muted mb-0">Nenhuma partida registrada ainda.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead>
                <tr><th>Data</th><th>Jogador A</th><th>Jogador B</th><th>Vencedor</th><th></th></tr>
              </thead>
              <tbody>
                <% partidas.forEach((p) => { %>
                  <tr>
                    <td><%= p.data_partida %></td>
                    <td><%= p.jogador_a %></td>
                    <td><%= p.jogador_b %></td>
                    <td><strong><%= p.vencedor %></strong></td>
                    <td class="text-end">
                      <a href="/eventos/<%= evento.id %>/partidas/<%= p.id %>/editar" class="btn btn-sm btn-outline-secondary">Editar</a>
                      <% if (evento.status !== 'encerrado') { %>
                        <form method="POST" action="/eventos/<%= evento.id %>/partidas/<%= p.id %>/excluir" class="d-inline"
                              onsubmit="return confirm('Excluir esta partida?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
