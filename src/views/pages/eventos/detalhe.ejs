<%- include('../../partials/header', { title }) %>

<%
  // Helpers de apresentação (não alteram dados)
  function fmtData(v) {
    if (!v) return ''
    var s = String(v).replace('T', ' ')
    var parts = s.split(' ')
    var d = parts[0] || ''
    var t = parts[1] || ''
    var dparts = d.split('-')
    var dd = dparts.length === 3 ? dparts[2] + '/' + dparts[1] + '/' + dparts[0] : d
    var tt = t.length >= 5 ? t.substring(0, 5) : ''
    return tt ? dd + ' · ' + tt : dd
  }

  function fmtMoeda(v) {
    var n = Number(v) || 0
    return 'R$ ' + n.toFixed(2).replace('.', ',')
  }

  // Resumo do evento
  var totalPartidas = partidas.length
  var totalVitorias = ranking.reduce(function (s, r) { return s + r.vitorias }, 0)
  var totalDerrotas = ranking.reduce(function (s, r) { return s + r.derrotas }, 0)
  var comJogos = ranking.filter(function (r) { return r.jogos > 0 })
  var aproveitamentoMedio = comJogos.length
    ? Math.round(comJogos.reduce(function (s, r) { return s + r.aproveitamento }, 0) / comJogos.length)
    : 0
  var barV = (totalVitorias + totalDerrotas) > 0 ? Math.round((totalVitorias / (totalVitorias + totalDerrotas)) * 100) : 0
  var barD = (totalVitorias + totalDerrotas) > 0 ? Math.round((totalDerrotas / (totalVitorias + totalDerrotas)) * 100) : 0
  var barP = totalPartidas > 0 ? 100 : 0
%>

<% if (msg) { %>
  <div class="p-alert p-alert--success mb-4" role="status"><%= msg %></div>
<% } %>
<% if (erro) { %>
  <div class="p-alert p-alert--danger mb-4" role="alert"><%= erro %></div>
<% } %>

<%- include('../../partials/modoAcesso', { tipo: 'eventos', item: evento, podeAdministrar: podeEditarEvento(evento.id) }) %>

<!-- ============ DASHBOARD ============ -->
<section id="dashboard" data-nav-target="dashboard" class="p-section" style="margin-top:0">
  <div class="p-hero">
    <h1 class="p-page__title h2 mb-2"><%= evento.nome %></h1>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <% if (evento.status === 'em_andamento') { %>
        <span class="p-badge p-badge--andamento"><%= statusLabel[evento.status] %></span>
      <% } else if (evento.status === 'planejado') { %>
        <span class="p-badge p-badge--planejado"><%= statusLabel[evento.status] %></span>
      <% } else { %>
        <span class="p-badge p-badge--encerrado"><%= statusLabel[evento.status] %></span>
      <% } %>
      <span class="p-hero__dates">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
        <%= formatarPeriodo(evento.data_inicio, evento.data_fim) %>
      </span>
      <span class="p-hero__dates" title="Valor da aposta padrão das partidas deste evento">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        Aposta padrão: <strong><%= fmtMoeda(evento.valor_aposta_padrao) %></strong>
      </span>
    </div>

    <!-- Ações grandes -->
    <div class="d-grid gap-2 d-md-flex">
      <a href="/eventos/<%= evento.id %>/painel" class="p-action-btn p-action-btn--report" target="_blank" rel="noopener">
        <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        Painel TV
      </a>
      <% if (podeEditarEvento(evento.id)) { %>
        <a href="/eventos/<%= evento.id %>/editar" class="p-action-btn p-action-btn--edit">
          <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
          Editar
        </a>
      <% } %>
      <a href="/eventos/<%= evento.id %>/relatorio" class="p-action-btn p-action-btn--report">
        <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
        Relatório
      </a>
      <% if (podeEditarEvento(evento.id)) { %>
        <% if (evento.status === 'planejado') { %>
          <form method="POST" action="/eventos/<%= evento.id %>/status" class="d-grid">
            <input type="hidden" name="status" value="em_andamento">
            <button type="submit" class="p-action-btn p-action-btn--status">
              <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              Iniciar evento
            </button>
          </form>
        <% } %>
        <% if (evento.status === 'em_andamento') { %>
          <form method="POST" action="/eventos/<%= evento.id %>/status" class="d-grid">
            <input type="hidden" name="status" value="encerrado">
            <button type="submit" class="p-action-btn p-action-btn--status">
              <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
              Encerrar evento
            </button>
          </form>
        <% } %>
        <% if (evento.status === 'encerrado') { %>
          <form method="POST" action="/eventos/<%= evento.id %>/status" class="d-grid">
            <input type="hidden" name="status" value="em_andamento">
            <button type="submit" class="p-action-btn p-action-btn--status">
              <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="M11 15l1 1 3-3"/></svg>
              Reabrir evento
            </button>
          </form>
        <% } %>
        <form method="POST" action="/eventos/<%= evento.id %>/excluir" class="d-grid"
              data-confirm="Excluir este evento? Esta ação não pode ser desfeita.">
          <button type="submit" class="p-action-btn p-action-btn--danger">
            <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
            Excluir
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Sorteio do próximo adversário -->
  <% if (evento.status !== 'encerrado') { %>
    <div class="p-card mt-4">
      <div class="p-card__body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="p-stat__icon p-stat__icon--green flex-shrink-0" aria-hidden="true">
            <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <div class="min-w-0">
            <h2 class="p-card__title">Próximo Adversário</h2>
            <p class="p-card__sub mb-0">Quem venceu a última partida?</p>
          </div>
        </div>

        <% if (jogadores.length < 2) { %>
          <p class="text-muted mb-0">Cadastre ao menos 2 jogadores para sortear o próximo adversário.</p>
        <% } else { %>
          <form method="GET" action="/eventos/<%= evento.id %>/sorteio" class="row g-2 align-items-end">
            <div class="col-12 col-md-7 p-field">
              <label for="vencedor_id" class="form-label">Quem está na mesa (vencedor atual)</label>
              <select class="form-select" id="vencedor_id" name="vencedor_id" required>
                <option value="">Selecione...</option>
                <% jogadores.filter((j) => j.ativo === 1).forEach((j) => { %>
                  <option value="<%= j.id %>" <%= typeof sorteio !== 'undefined' && sorteio && sorteio.vencedor && sorteio.vencedor.id === j.id ? 'selected' : '' %>>
                    <%= j.nome %><%= j.apelido ? ' (' + j.apelido + ')' : '' %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-12 col-md-5">
              <button type="submit" class="btn p-btn p-btn--glow w-100">
                🎲 Sortear Próximo Adversário
              </button>
            </div>
          </form>

          <% if (sorteio && sorteio.semOponente) { %>
            <div class="p-alert p-alert--warning mt-3 mb-0">
              <%= sorteio.vencedor.nome %> é o único jogador ativo do evento. Não há adversários para sortear.
            </div>
          <% } else if (sorteio && sorteio.sugestao) { %>
            <div class="p-alert p-alert--success mt-3 mb-0 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
              <span class="min-w-0">
                Próximo confronto sugerido: <strong><%= sorteio.vencedor.nome %></strong> ×
                <strong><%= sorteio.sugestao.nome %></strong>
                <% if (sorteio.ultimoAdversario) { %>
                  <br><small class="text-muted">Último adversário de <%= sorteio.vencedor.nome %>: <%= sorteio.ultimoAdversarioNome %></small>
                <% } %>
              </span>
              <% if (podeEditarEvento(evento.id)) { %>
                <a class="btn p-btn p-btn--primary flex-shrink-0" href="/eventos/<%= evento.id %>/partidas/novo?jogador_a_id=<%= sorteio.vencedor.id %>&jogador_b_id=<%= sorteio.sugestao.id %>">
                  Registrar partida
                </a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Resumo do evento -->
  <div class="p-card mt-4">
    <div class="p-card__body">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="p-stat__icon p-stat__icon--blue flex-shrink-0" aria-hidden="true">
          <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
        </div>
        <h2 class="p-card__title mb-0">Resumo do Evento</h2>
      </div>

      <div class="p-stats">
        <div class="p-stat p-fade-in">
          <div class="p-stat__head">
            <div class="p-stat__icon p-stat__icon--blue"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
          </div>
          <div class="p-stat__value"><%= totalPartidas %></div>
          <div class="p-stat__label">Partidas</div>
          <div class="p-bar"><div class="p-bar__fill p-bar__fill--blue" data-width="<%= barP %>"></div></div>
        </div>
        <div class="p-stat p-fade-in">
          <div class="p-stat__head">
            <div class="p-stat__icon p-stat__icon--green"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg></div>
          </div>
          <div class="p-stat__value"><%= totalVitorias %></div>
          <div class="p-stat__label">Vitórias</div>
          <div class="p-bar"><div class="p-bar__fill p-bar__fill--green" data-width="<%= barV %>"></div></div>
        </div>
        <div class="p-stat p-fade-in">
          <div class="p-stat__head">
            <div class="p-stat__icon p-stat__icon--red"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg></div>
          </div>
          <div class="p-stat__value"><%= totalDerrotas %></div>
          <div class="p-stat__label">Derrotas</div>
          <div class="p-bar"><div class="p-bar__fill p-bar__fill--red" data-width="<%= barD %>"></div></div>
        </div>
        <div class="p-stat p-fade-in">
          <div class="p-stat__head">
            <div class="p-stat__icon p-stat__icon--gold"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
          </div>
          <div class="p-stat__value"><%= aproveitamentoMedio %>%</div>
          <div class="p-stat__label">Aproveitamento</div>
          <div class="p-bar"><div class="p-bar__fill p-bar__fill--gold" data-width="<%= aproveitamentoMedio %>"></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ RANKING ============ -->
<section id="ranking" data-nav-target="ranking" class="p-section">
  <h2 class="p-section__title">
    <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
    Ranking
  </h2>

  <% if (ranking.length === 0) { %>
    <div class="p-empty">
      <div class="p-empty__icon">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
      </div>
      <p class="mb-0">Nenhum jogador no evento ainda.</p>
    </div>
  <% } else { %>
    <div class="p-ranking p-stagger">
      <% ranking.forEach((r) => { %>
        <div class="p-rank-card <%= r.posicao === 1 ? 'p-rank-card--top1' : (r.posicao === 2 ? 'p-rank-card--top2' : (r.posicao === 3 ? 'p-rank-card--top3' : '')) %>">
          <div class="p-rank-card__pos <%= r.posicao <= 3 ? 'p-rank-card__pos--medal' : '' %>" aria-hidden="true">
            <% if (r.posicao === 1) { %>🥇<% } else if (r.posicao === 2) { %>🥈<% } else if (r.posicao === 3) { %>🥉<% } else { %><%= r.posicao %><% } %>
          </div>
          <div class="p-rank-card__main">
            <div class="p-rank-card__head">
              <div class="p-avatar <%= r.posicao === 1 ? 'p-avatar--gold' : '' %>" aria-hidden="true"><%= String(r.jogador.nome || '?').charAt(0).toUpperCase() %></div>
              <div class="min-w-0">
                <a href="/eventos/<%= evento.id %>/jogadores/<%= r.jogador.id %>/campanha" class="p-rank-card__name d-block text-decoration-none">
                  <%= r.jogador.nome %>
                </a>
                <% if (r.jogador.apelido) { %>
                  <span class="p-rank-card__alias">@<%= r.jogador.apelido %></span>
                <% } %>
              </div>
            </div>
            <div class="p-rank-card__nums">
              <div class="p-rank-card__num"><b><%= r.jogos %></b> <span>jogos</span></div>
              <div class="p-rank-card__num"><b class="text-success"><%= r.vitorias %></b> <span>vitórias</span></div>
              <div class="p-rank-card__num"><b class="text-danger"><%= r.derrotas %></b> <span>derrotas</span></div>
            </div>
            <div class="p-rank-card__aproveitamento">
              <div class="p-rank-card__aproveitamento-head">
                <span>Aproveitamento</span>
                <b><%= r.aproveitamento %>%</b>
              </div>
              <div class="p-bar">
                <div class="p-bar__fill <%= r.aproveitamento >= 60 ? 'p-bar__fill--green' : (r.aproveitamento >= 40 ? 'p-bar__fill--gold' : 'p-bar__fill--red') %>" data-width="<%= r.aproveitamento %>"></div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- ============ FINANCEIRO / ACERTO DE CONTAS ============ -->
<section id="financeiro" data-nav-target="financeiro" class="p-section">
  <div class="d-flex align-items-center justify-content-between mb-3 gap-2 flex-wrap">
    <h2 class="p-section__title mb-0">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
      Financeiro — Acerto de Contas
    </h2>
    <div class="d-flex gap-2 flex-wrap">
      <span class="p-badge p-badge--andamento"><%= financeiro.partidasApostadas %> partida(s) com aposta</span>
      <span class="p-badge p-badge--planejado">Total movimentado: <%= fmtMoeda(financeiro.totalMovimentado) %></span>
      <span class="p-badge p-badge--andamento"><%= financeiro.partidasPagas %> paga(s) · <%= fmtMoeda(financeiro.totalPago) %></span>
      <span class="p-badge p-badge--planejado"><%= financeiro.partidasPendentes %> pendente(s) · <%= fmtMoeda(financeiro.totalPendente) %></span>
    </div>
  </div>

  <% if (financeiro.totalMovimentado === 0) { %>
    <div class="p-empty">
      <div class="p-empty__icon">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
      </div>
      <div>
        <p class="fw-semibold mb-1">Nenhuma aposta registrada neste evento</p>
        <p class="mb-0">Defina um valor de aposta nas partidas para acompanhar o acerto de contas dos jogadores.</p>
      </div>
    </div>
  <% } else { %>
    <div class="p-financeiro">
      <div class="p-financeiro__jogadores p-stagger">
        <% financeiro.jogadoresFinanceiros.forEach((fin) => { %>
          <div class="p-fin-card">
            <div class="p-fin-card__head">
              <div class="p-avatar" aria-hidden="true"><%= String(fin.jogador.nome || '?').charAt(0).toUpperCase() %></div>
              <div class="min-w-0">
                <div class="p-fin-card__name"><%= fin.jogador.nome %></div>
                <div class="p-fin-card__partidas"><%= fin.partidasApostadas %> partida(s) apostada(s)</div>
              </div>
              <div class="p-fin-card__saldo <%= fin.saldo > 0 ? 'p-fin-card__saldo--positivo' : (fin.saldo < 0 ? 'p-fin-card__saldo--negativo' : '') %>">
                <%= fin.saldo >= 0 ? '👍' : '👎' %> <%= fmtMoeda(Math.abs(fin.saldo)) %>
              </div>
            </div>
            <div class="p-fin-card__linha">
              <span>A receber</span>
              <b class="p-fin-positivo"><%= fmtMoeda(fin.aReceber) %></b>
            </div>
            <div class="p-fin-card__linha">
              <span>A pagar</span>
              <b class="p-fin-negativo"><%= fmtMoeda(fin.aPagar) %></b>
            </div>
            <% if (fin.partidasPagas > 0) { %>
              <div class="p-fin-card__linha">
                <span>Já quitado</span>
                <b class="p-fin-positivo"><%= fin.partidasPagas %> · <%= fmtMoeda(fin.valorQuitado) %></b>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>

      <div class="p-financeiro__acertos">
        <h3 class="p-financeiro__subtitle">
          <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
          Quem deve para quem
        </h3>
        <% if (financeiro.acertos.length === 0) { %>
          <div class="p-alert p-alert--success mb-0">
            🎉 Tudo quites! Não há valores a pagar neste momento.
          </div>
        <% } else { %>
          <div class="p-acerto-list p-stagger">
            <% financeiro.acertos.forEach((a) => { %>
              <div class="p-acerto">
                <div class="p-acerto__devedor">
                  <span class="p-acerto__nome"><%= a.devedor.nome %></span>
                  <span class="p-acerto__tag p-acerto__tag--deve">deve</span>
                </div>
                <div class="p-acerto__valor">→ <%= fmtMoeda(a.valor) %> →</div>
                <div class="p-acerto__credor">
                  <span class="p-acerto__nome"><%= a.credor.nome %></span>
                  <span class="p-acerto__tag p-acerto__tag--recebe">recebe</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (financeiro.desistentes && financeiro.desistentes.length > 0) { %>
    <div class="p-financeiro__desistentes mt-4">
      <h3 class="p-financeiro__subtitle">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M21 3 3 21"/></svg>
        Desistentes (acertados na saída)
      </h3>
      <p class="p-card__sub">Partidas já realizadas antes da desistência; estes valores foram acertados na saída e não entram mais nos cálculos do evento.</p>
      <div class="p-financeiro__jogadores">
        <% financeiro.desistentes.forEach((fin) => { %>
          <div class="p-fin-card p-fin-card--inativo">
            <div class="p-fin-card__head">
              <div class="p-avatar" aria-hidden="true"><%= String(fin.jogador.nome || '?').charAt(0).toUpperCase() %></div>
              <div class="min-w-0">
                <div class="p-fin-card__name"><%= fin.jogador.nome %></div>
                <div class="p-fin-card__partidas"><%= fin.partidasApostadas %> partida(s) apostada(s)</div>
              </div>
              <div class="p-fin-card__saldo <%= fin.saldo > 0 ? 'p-fin-card__saldo--positivo' : (fin.saldo < 0 ? 'p-fin-card__saldo--negativo' : '') %>">
                <%= fin.saldo >= 0 ? '👍' : '👎' %> <%= fmtMoeda(Math.abs(fin.saldo)) %>
              </div>
            </div>
            <div class="p-fin-card__linha">
              <span>A receber</span>
              <b class="p-fin-positivo"><%= fmtMoeda(fin.aReceber) %></b>
            </div>
            <div class="p-fin-card__linha">
              <span>A pagar</span>
              <b class="p-fin-negativo"><%= fmtMoeda(fin.aPagar) %></b>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>

<!-- ============ JOGADORES ============ -->
<section id="jogadores" data-nav-target="jogadores" class="p-section">
  <div class="d-flex align-items-center justify-content-between mb-3 gap-2">
    <h2 class="p-section__title mb-0">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Jogadores
    </h2>
    <% if (podeEditarEvento(evento.id)) { %>
      <a href="/eventos/<%= evento.id %>/jogadores/novo" class="btn btn-primary p-btn p-btn--primary d-none d-md-inline-flex flex-shrink-0">
        + Jogador
      </a>
    <% } %>
  </div>

  <% if (jogadores.length === 0) { %>
    <div class="p-empty">
      <div class="p-empty__icon">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      </div>
      <p class="mb-0">Nenhum jogador cadastrado neste evento.</p>
    </div>
  <% } else { %>
    <div class="p-players p-stagger">
      <% jogadores.forEach((j) => { %>
        <div class="p-player-card <%= j.ativo === 0 ? 'p-player-card--inativo' : '' %>">
          <% if (podeEditarEvento(evento.id)) { %>
            <a href="/eventos/<%= evento.id %>/jogadores/<%= j.id %>/editar"
               class="p-player-card__link" aria-label="Editar <%= j.nome %>">
              <div class="p-avatar" aria-hidden="true"><%= String(j.nome || '?').charAt(0).toUpperCase() %></div>
              <div class="p-player-card__main">
                <div class="p-player-card__name"><%= j.nome %></div>
                <% if (j.apelido) { %>
                  <div class="p-player-card__alias">@<%= j.apelido %></div>
                <% } %>
              </div>
            </a>
          <% } else { %>
            <div class="p-player-card__link">
              <div class="p-avatar" aria-hidden="true"><%= String(j.nome || '?').charAt(0).toUpperCase() %></div>
              <div class="p-player-card__main">
                <div class="p-player-card__name"><%= j.nome %></div>
                <% if (j.apelido) { %>
                  <div class="p-player-card__alias">@<%= j.apelido %></div>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (j.ativo === 0) { %>
            <span class="p-badge p-badge--encerrado flex-shrink-0">⏸ parou de jogar</span>
          <% } else if (podeEditarEvento(evento.id) && evento.status !== 'encerrado') { %>
            <form method="POST" action="/eventos/<%= evento.id %>/jogadores/<%= j.id %>/desistir" class="d-inline flex-shrink-0"
                  data-confirm="Marcar <%= j.nome %> como desistente? As partidas dele serão acertadas na hora e ele sairá do ranking.">
              <button type="submit" class="p-icon-btn p-icon-btn--danger" aria-label="Desistir" title="Desistir">
                <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M21 3 3 21"/><path d="M21 14v4a3 3 0 0 1-3 3h-4"/><path d="M3 10v4a3 3 0 0 0 3 3h4"/></svg>
              </button>
            </form>
          <% } %>
          <% if (podeEditarEvento(evento.id)) { %>
            <a href="/eventos/<%= evento.id %>/jogadores/<%= j.id %>/editar"
               class="p-player-card__chevron" aria-label="Editar <%= j.nome %>">
              <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- ============ PARTIDAS ============ -->
<section id="partidas" data-nav-target="partidas" class="p-section">
  <div class="d-flex align-items-center justify-content-between mb-3 gap-2">
    <h2 class="p-section__title mb-0">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M8 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/><path d="M13 13h3"/></svg>
      Partidas
    </h2>
    <% if (podeEditarEvento(evento.id)) { %>
      <a href="/eventos/<%= evento.id %>/partidas/novo" class="btn btn-primary p-btn p-btn--primary flex-shrink-0">
        + Partida
      </a>
    <% } %>
  </div>

  <% if (partidas.length === 0) { %>
    <div class="p-empty">
      <div class="p-empty__icon">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
      </div>
      <p class="mb-0">Nenhuma partida registrada ainda.</p>
    </div>
  <% } else { %>
    <div class="p-matches p-stagger">
      <% partidas.forEach((p) => { %>
        <div class="p-match-card">
          <div class="p-match-card__meta">
            <span class="d-flex align-items-center gap-2">
              <span class="p-match-card__date">
                <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                <%= fmtData(p.data_partida) || 'Data não informada' %>
              </span>
              <span class="p-match-bet <%= Number(p.valor_aposta) > 0 ? 'p-match-bet--aposta' : 'p-match-bet--limpa' %>">
                <%= Number(p.valor_aposta) > 0 ? fmtMoeda(p.valor_aposta) : 'Sem aposta' %>
              </span>
              <% if (podeEditarEvento(evento.id) && Number(p.valor_aposta) > 0) { %>
                <form method="POST" action="/eventos/<%= evento.id %>/partidas/<%= p.id %>/pago" class="d-inline-flex">
                  <button type="submit"
                          class="p-match-paid p-match-paid--<%= p.pago === 1 ? 'sim' : 'nao' %>"
                          aria-pressed="<%= p.pago === 1 ? 'true' : 'false' %>"
                          title="<%= p.pago === 1 ? 'Marcar como pendente' : 'Marcar como paga' %>">
                    <%= p.pago === 1 ? '✓ Pago' : 'Pendente' %>
                  </button>
                </form>
              <% } %>
            </span>
            <% if (podeEditarEvento(evento.id)) { %>
              <span class="p-match-card__actions">
                <a href="/eventos/<%= evento.id %>/partidas/<%= p.id %>/editar" class="p-icon-btn p-icon-btn--edit"
                   aria-label="Editar partida" title="Editar">
                  <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                </a>
                <% if (evento.status !== 'encerrado') { %>
                  <form method="POST" action="/eventos/<%= evento.id %>/partidas/<%= p.id %>/excluir" class="d-inline"
                        data-confirm="Excluir esta partida?">
                    <button type="submit" class="p-icon-btn p-icon-btn--danger" aria-label="Excluir partida" title="Excluir">
                      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    </button>
                  </form>
                <% } %>
              </span>
            <% } %>
          </div>
          <div class="p-match-card__players">
            <div class="p-match-card__player <%= p.vencedor === p.jogador_a ? 'p-match-card__player--winner' : '' %>">
              <%= p.jogador_a %>
              <% if (p.vencedor === p.jogador_a) { %><span class="ms-1" aria-hidden="true">🏆</span><% } %>
            </div>
            <span class="p-match-card__vs">VS</span>
            <div class="p-match-card__player <%= p.vencedor === p.jogador_b ? 'p-match-card__player--winner' : '' %>">
              <%= p.jogador_b %>
              <% if (p.vencedor === p.jogador_b) { %><span class="ms-1" aria-hidden="true">🏆</span><% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../../partials/bottomnav', { eventoId: evento.id, active: 'dashboard' }) %>

<% if (podeEditarEvento(evento.id)) { %>
<a id="fab-contextual" class="p-fab"
   href="/eventos/<%= evento.id %>/partidas/novo"
   aria-label="Nova partida"
   data-fab-dashboard-href="/eventos/<%= evento.id %>/partidas/novo"
   data-fab-dashboard-label="Nova partida"
   data-fab-ranking-href="/eventos/<%= evento.id %>/partidas/novo"
   data-fab-ranking-label="Nova partida"
   data-fab-jogadores-href="/eventos/<%= evento.id %>/jogadores/novo"
   data-fab-jogadores-label="Adicionar jogador"
   data-fab-partidas-href="/eventos/<%= evento.id %>/partidas/novo"
   data-fab-partidas-label="Nova partida">
  <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
  <span class="p-fab__label">Nova partida</span>
</a>
<% } %>

<%- include('../../partials/footer') %>
