<%- include('../../partials/header', { title }) %>

<%
  function fmtData(v) {
    if (!v) return ''
    var s = String(v).replace('T', ' ')
    var parts = s.split(' ')
    var d = parts[0] || ''
    var t = parts[1] || ''
    var dparts = d.split('-')
    var dd = dparts.length === 3 ? dparts[2] + '/' + dparts[1] + '/' + dparts[0] : d
    var tt = t.length >= 5 ? t.substring(0, 5) : ''
    return tt ? dd + ' · ' + tt : dd
  }

  function fmtMoeda(v) {
    var n = Number(v) || 0
    return 'R$ ' + n.toFixed(2).replace('.', ',')
  }

  var totalPartidas = partidas.length
  var totalVitorias = ranking.reduce(function (s, r) { return s + r.vitorias }, 0)
  var totalDerrotas = ranking.reduce(function (s, r) { return s + r.derrotas }, 0)
  var comJogos = ranking.filter(function (r) { return r.jogos > 0 })
  var aproveitamentoMedio = comJogos.length
    ? Math.round(comJogos.reduce(function (s, r) { return s + r.aproveitamento }, 0) / comJogos.length)
    : 0
%>

<div class="report">

  <!-- Cabeçalho do evento -->
  <header class="report__head">
    <h1 class="report__title">🏆 <%= evento.nome %></h1>
    <div class="report__meta">
      <span>Status: <strong><%= statusLabel[evento.status] %></strong></span>
      <span>Início: <strong><%= evento.data_inicio %></strong></span>
      <span>Fim: <strong><%= evento.data_fim %></strong></span>
      <span>Aposta padrão: <strong><%= fmtMoeda(evento.valor_aposta_padrao) %></strong></span>
      <span>Gerado em: <strong><%= new Date().toLocaleString('pt-BR') %></strong></span>
    </div>
  </header>

  <!-- Resumo -->
  <section class="report__section">
    <h2 class="report__section-title">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
      Resumo do Evento
    </h2>
    <div class="report__stats">
      <div class="report__stat">
        <div class="report__stat-value"><%= totalPartidas %></div>
        <div class="report__stat-label">Partidas</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= totalVitorias %></div>
        <div class="report__stat-label">Vitórias</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= totalDerrotas %></div>
        <div class="report__stat-label">Derrotas</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= aproveitamentoMedio %>%</div>
        <div class="report__stat-label">Aproveitamento</div>
      </div>
    </div>
  </section>

  <!-- Jogadores cadastrados -->
  <section class="report__section">
    <h2 class="report__section-title">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Jogadores Cadastrados (<%= jogadores.length %>)
    </h2>
    <% if (jogadores.length === 0) { %>
      <p class="report__empty">Nenhum jogador cadastrado neste evento.</p>
    <% } else { %>
      <div class="report__players">
        <% jogadores.forEach((j) => { %>
          <div class="report__player">
            <span class="report__avatar" aria-hidden="true"><%= String(j.nome || '?').charAt(0).toUpperCase() %></span>
            <span class="report__player-name">
              <%= j.nome %>
              <% if (j.apelido) { %><span class="report__player-alias d-block">@<%= j.apelido %></span><% } %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Ranking -->
  <section class="report__section">
    <h2 class="report__section-title">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
      Ranking
    </h2>
    <% if (ranking.length === 0) { %>
      <p class="report__empty">Nenhum jogador no evento ainda.</p>
    <% } else { %>
      <table class="report__table">
        <thead>
          <tr>
            <th>#</th>
            <th>Jogador</th>
            <th>Jogos</th>
            <th>Vitórias</th>
            <th>Derrotas</th>
            <th>Aproveitamento</th>
          </tr>
        </thead>
        <tbody>
          <% ranking.forEach((r) => { %>
            <tr>
              <td><%= r.posicao === 1 ? '🥇 ' : (r.posicao === 2 ? '🥈 ' : (r.posicao === 3 ? '🥉 ' : '')) %><%= r.posicao %></td>
              <td><%= r.jogador.nome %><%= r.jogador.apelido ? ' (' + r.jogador.apelido + ')' : '' %></td>
              <td><%= r.jogos %></td>
              <td><%= r.vitorias %></td>
              <td><%= r.derrotas %></td>
              <td><%= r.aproveitamento %>%</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <!-- Partidas por jogador -->
  <section class="report__section">
    <h2 class="report__section-title">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M8 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/><path d="M13 13h3"/></svg>
      Partidas por Jogador
    </h2>

    <% if (partidasPorJogador.length === 0) { %>
      <p class="report__empty">Nenhum jogador no evento ainda.</p>
    <% } else { %>
      <% partidasPorJogador.forEach((bloco) => { %>
        <div class="report__player-matches">
          <div class="report__player-matches-head">
            <span class="report__avatar" aria-hidden="true"><%= String(bloco.jogador.nome || '?').charAt(0).toUpperCase() %></span>
            <span><%= bloco.jogador.nome %><%= bloco.jogador.apelido ? ' (@' + bloco.jogador.apelido + ')' : '' %></span>
            <span class="report__player-matches-stats">
              <%= bloco.partidas.length %> partida(s) ·
              <%= bloco.vitorias %>V · <%= bloco.derrotas %>D
            </span>
          </div>

          <% if (bloco.partidas.length === 0) { %>
            <p class="report__empty">Sem partidas registradas.</p>
          <% } else { %>
            <% bloco.partidas.forEach((p) => { %>
              <div class="report__match <%= p.venceu ? 'report__match--win' : '' %>">
                <span class="report__match-date">
                  <%= fmtData(p.data_partida) || 'Data não informada' %>
                </span>
                <span><strong><%= p.jogador_a %></strong> vs <strong><%= p.jogador_b %></strong></span>
                <span class="report__match-result <%= p.venceu ? 'report__match-result--win' : 'report__match-result--loss' %>">
                  <%= p.venceu ? '✔ Vitória' : '✘ Derrota' %>
                </span>
              </div>
            <% }) %>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </section>

  <!-- Controle financeiro (acerto de contas) -->
  <section class="report__section">
    <h2 class="report__section-title">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
      Controle Financeiro — Acerto de Contas
    </h2>

    <div class="report__stats">
      <div class="report__stat">
        <div class="report__stat-value"><%= financeiro.partidasApostadas %></div>
        <div class="report__stat-label">Partidas com aposta</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= fmtMoeda(financeiro.totalMovimentado) %></div>
        <div class="report__stat-label">Total movimentado</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= financeiro.partidasPagas %></div>
        <div class="report__stat-label">Partidas pagas</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= financeiro.partidasPendentes %></div>
        <div class="report__stat-label">Partidas pendentes</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= fmtMoeda(financeiro.totalPago) %></div>
        <div class="report__stat-label">Total pago</div>
      </div>
      <div class="report__stat">
        <div class="report__stat-value"><%= fmtMoeda(financeiro.totalPendente) %></div>
        <div class="report__stat-label">Total pendente</div>
      </div>
    </div>

    <% if (financeiro.totalMovimentado === 0) { %>
      <p class="report__empty">Nenhuma aposta registrada neste evento.</p>
    <% } else { %>
      <h3 class="report__subtitle">Situação por jogador</h3>
      <table class="report__table">
<thead>
            <tr>
              <th>Jogador</th>
              <th>Partidas c/ aposta</th>
              <th>Já quitado</th>
              <th>A receber</th>
              <th>A pagar</th>
              <th>Saldo</th>
            </tr>
          </thead>
          <tbody>
            <% financeiro.jogadoresFinanceiros.forEach((fin) => { %>
              <tr>
                <td><%= fin.jogador.nome %><%= fin.jogador.apelido ? ' (' + fin.jogador.apelido + ')' : '' %></td>
                <td><%= fin.partidasApostadas %></td>
                <td><%= fin.partidasPagas > 0 ? fin.partidasPagas + ' · ' + fmtMoeda(fin.valorQuitado) : '—' %></td>
              <td class="report__money report__money--receber"><%= fmtMoeda(fin.aReceber) %></td>
              <td class="report__money report__money--pagar"><%= fmtMoeda(fin.aPagar) %></td>
              <td class="report__money <%= fin.saldo < 0 ? 'report__money--pagar' : 'report__money--receber' %>">
                <%= fmtMoeda(fin.saldo) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <h3 class="report__subtitle">Quem deve para quem</h3>
      <% if (financeiro.acertos.length === 0) { %>
        <p class="report__empty">🎉 Tudo quites! Não há valores a pagar neste momento.</p>
      <% } else { %>
        <table class="report__table">
          <thead>
            <tr>
              <th>Quem paga</th>
              <th>Valor</th>
              <th>Quem recebe</th>
            </tr>
          </thead>
          <tbody>
            <% financeiro.acertos.forEach((a) => { %>
              <tr>
                <td><strong><%= a.devedor.nome %></strong><%= a.devedor.apelido ? ' (' + a.devedor.apelido + ')' : '' %></td>
                <td class="report__money report__money--pagar"><%= fmtMoeda(a.valor) %></td>
                <td><strong><%= a.credor.nome %></strong><%= a.credor.apelido ? ' (' + a.credor.apelido + ')' : '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } %>

    <% if (financeiro.desistentes && financeiro.desistentes.length > 0) { %>
      <h3 class="report__subtitle">Desistentes (acertados na saída)</h3>
      <p class="report__empty">Partidas realizadas antes da desistência; os valores foram acertados na saída e não entram mais nos cálculos do evento.</p>
      <table class="report__table">
        <thead>
          <tr>
            <th>Jogador</th>
            <th>Partidas c/ aposta</th>
            <th>A receber</th>
            <th>A pagar</th>
            <th>Saldo</th>
          </tr>
        </thead>
        <tbody>
          <% financeiro.desistentes.forEach((fin) => { %>
            <tr>
              <td><%= fin.jogador.nome %><%= fin.jogador.apelido ? ' (' + fin.jogador.apelido + ')' : '' %></td>
              <td><%= fin.partidasApostadas %></td>
              <td class="report__money report__money--receber"><%= fmtMoeda(fin.aReceber) %></td>
              <td class="report__money report__money--pagar"><%= fmtMoeda(fin.aPagar) %></td>
              <td class="report__money <%= fin.saldo < 0 ? 'report__money--pagar' : 'report__money--receber' %>">
                <%= fmtMoeda(fin.saldo) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

</div>

<!-- Barra de ações -->
<div class="report-toolbar" role="toolbar" aria-label="Ações do relatório">
  <button type="button" class="report-toolbar__btn report-toolbar__btn--share" id="btn-compartilhar">
    <svg class="report-toolbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
    Compartilhar
  </button>
  <button type="button" class="report-toolbar__btn report-toolbar__btn--pdf" id="btn-pdf">
    <svg class="report-toolbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15h6"/><path d="M9 11h6"/></svg>
    Salvar em PDF
  </button>
  <button type="button" class="report-toolbar__btn report-toolbar__btn--print" id="btn-imprimir">
    <svg class="report-toolbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    Imprimir
  </button>
  <button type="button" class="report-toolbar__btn report-toolbar__btn--close" id="btn-fechar">
    <svg class="report-toolbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    Fechar
  </button>
</div>

<!-- Menu do compartilhar -->
<div class="report-share-menu" id="report-share-menu" hidden>
  <p class="report-share-menu__title">Compartilhar como</p>
  <button type="button" class="report-share-menu__btn" data-share="pdf">
    <svg class="report-share-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15h6"/><path d="M9 11h6"/></svg>
    PDF
  </button>
  <button type="button" class="report-share-menu__btn" data-share="imagem">
    <svg class="report-share-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"/></svg>
    Imagem
  </button>
  <button type="button" class="report-share-menu__btn" data-share="link">
    <svg class="report-share-menu__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    Link
  </button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
(function () {
  var url = window.location.href
  var titulo = 'Relatório — <%= evento.nome %>'
  var btnImprimir = document.getElementById('btn-imprimir')
  var btnPdf = document.getElementById('btn-pdf')
  var btnCompartilhar = document.getElementById('btn-compartilhar')
  var btnFechar = document.getElementById('btn-fechar')
  var menu = document.getElementById('report-share-menu')
  var relatorio = document.querySelector('.report')

  function abrirMenu() {
    if (menu) menu.hidden = false
  }
  function fecharMenu() {
    if (menu) menu.hidden = true
  }

  if (btnImprimir) {
    btnImprimir.addEventListener('click', function () { window.print() })
  }
  if (btnPdf) {
    btnPdf.addEventListener('click', function () { window.print() })
  }
  if (btnFechar) {
    btnFechar.addEventListener('click', function () {
      if (window.history.length > 1) {
        window.history.back()
      } else {
        window.location.href = '/eventos/<%= evento.id %>'
      }
    })
  }
  if (btnCompartilhar) {
    btnCompartilhar.addEventListener('click', function (e) {
      e.stopPropagation()
      abrirMenu()
    })
  }

  function compartilharLink() {
    var dados = { title: titulo, text: 'Relatório do evento ' + '<%= evento.nome %>', url: url }
    if (navigator.share) {
      navigator.share(dados).catch(function () {})
    } else if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(function () {
        alert('Link copiado para a área de transferência!')
      }).catch(function () {})
    } else {
      window.prompt('Copie o link do relatório:', url)
    }
  }

  function nomeArquivo(ext) {
    var slug = ('<%= evento.nome %>').toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    return 'relatorio-' + (slug || 'evento') + '.' + ext
  }

  function capturar(tipo) {
    var el = relatorio || document.body
    document.documentElement.classList.add('capture')
    return new Promise(function (resolve) {
      requestAnimationFrame(function () {
        html2canvas(el, {
          scale: 2,
          useCORS: true,
          backgroundColor: '#ffffff',
          windowWidth: el.scrollWidth,
          onclone: function () {}
        }).then(function (canvas) {
          document.documentElement.classList.remove('capture')
          resolve(canvas)
        }).catch(function (err) {
          document.documentElement.classList.remove('capture')
          throw err
        })
      })
    })
  }

  function canvasParaPdfBlob(canvas) {
    var imgData = canvas.toDataURL('image/png')
    var jsPDF = window.jspdf && window.jspdf.jsPDF
    if (!jsPDF) throw new Error('jsPDF indisponível')
    var pdf = new jsPDF('p', 'mm', 'a4')
    var largura = pdf.internal.pageSize.getWidth()
    var altura = pdf.internal.pageSize.getHeight()
    var imgLargura = largura
    var imgAltura = (canvas.height * imgLargura) / canvas.width
    var posicao = 0
    pdf.addImage(imgData, 'PNG', 0, posicao, imgLargura, imgAltura)
    var restante = imgAltura - altura
    while (restante > 0) {
      posicao -= altura
      pdf.addPage()
      pdf.addImage(imgData, 'PNG', 0, posicao, imgLargura, imgAltura)
      restante -= altura
    }
    return pdf.output('blob')
  }

  function compartilharArquivo(blob, nome) {
    var arquivo = new File([blob], nome, { type: blob.type })
    if (navigator.canShare && navigator.canShare({ files: [arquivo] })) {
      navigator.share({
        files: [arquivo],
        title: titulo,
        text: 'Relatório do evento ' + '<%= evento.nome %>'
      }).catch(function () {})
    } else {
      var a = document.createElement('a')
      a.href = URL.createObjectURL(blob)
      a.download = nome
      document.body.appendChild(a)
      a.click()
      a.remove()
      setTimeout(function () { URL.revokeObjectURL(a.href) }, 1000)
    }
  }

  function feedback(texto) {
    if (btnCompartilhar) {
      var original = btnCompartilhar.textContent
      btnCompartilhar.textContent = texto
      btnCompartilhar.disabled = true
      setTimeout(function () {
        btnCompartilhar.textContent = original
        btnCompartilhar.disabled = false
      }, 1600)
    }
  }

  if (menu) {
    menu.addEventListener('click', function (e) {
      var alvo = e.target.closest('[data-share]')
      if (!alvo) return
      var opcao = alvo.getAttribute('data-share')
      fecharMenu()
      if (opcao === 'link') {
        compartilharLink()
        return
      }
      if (!window.html2canvas) {
        alert('Não foi possível carregar o gerador de arquivos. Verifique a conexão.')
        return
      }
      feedback('Gerando...')
      capturar(opcao).then(function (canvas) {
        if (opcao === 'pdf') {
          var blob = canvasParaPdfBlob(canvas)
          compartilharArquivo(blob, nomeArquivo('pdf'))
        } else {
          canvas.toBlob(function (blob) {
            if (blob) compartilharArquivo(blob, nomeArquivo('png'))
          }, 'image/png')
        }
      }).catch(function (err) {
        alert('Falha ao gerar o arquivo. Tente novamente.')
      })
    })
  }

  document.addEventListener('click', function () { fecharMenu() })
})()
</script>

<%- include('../../partials/footer') %>
