<%- include('../../partials/header', { title }) %>

<%
  function fmtMoeda(v) {
    var n = Number(v) || 0
    return 'R$ ' + n.toFixed(2).replace('.', ',')
  }
  var apostaPadrao = Number(evento.valor_aposta_padrao) || 0
%>

<div class="mb-4">
  <h1 class="p-page__title h2 mb-1"><%= title %></h1>
  <p class="p-page__subtitle mb-0">Evento: <%= evento.nome %></p>
</div>

<% if (erros && erros.geral) { %>
  <div class="p-alert p-alert--danger mb-4" role="alert"><%= erros.geral %></div>
<% } %>

<% if (jogadores.length < 2) { %>
  <div class="p-alert p-alert--warning mb-4">
    É necessário cadastrar ao menos <strong>2 jogadores</strong> no evento para registrar partidas.
    <a href="/eventos/<%= evento.id %>/jogadores/novo">Cadastrar jogador</a>
  </div>
<% } %>

<form method="POST"
      action="<%= partida.id ? '/eventos/' + evento.id + '/partidas/' + partida.id : '/eventos/' + evento.id + '/partidas' %>">
  <div class="p-card">
    <div class="p-card__body">
      <div class="row g-3">
        <div class="col-md-6 p-field">
          <label for="jogador_a_id" class="form-label">Jogador A *</label>
          <select class="form-select <%= erros && erros.jogador_a_id ? 'is-invalid' : '' %>"
                  id="jogador_a_id" name="jogador_a_id" required>
            <option value="">Selecione...</option>
            <% jogadores.forEach((j) => { %>
              <option value="<%= j.id %>" <%= String(partida.jogador_a_id) === String(j.id) ? 'selected' : '' %>>
                <%= j.nome %><%= j.apelido ? ' (' + j.apelido + ')' : '' %>
              </option>
            <% }) %>
          </select>
          <% if (erros && erros.jogador_a_id) { %>
            <div class="invalid-feedback"><%= erros.jogador_a_id %></div>
          <% } %>
        </div>

        <div class="col-md-6 p-field">
          <label for="jogador_b_id" class="form-label">Jogador B *</label>
          <select class="form-select <%= erros && erros.jogador_b_id ? 'is-invalid' : '' %>"
                  id="jogador_b_id" name="jogador_b_id" required>
            <option value="">Selecione...</option>
            <% jogadores.forEach((j) => { %>
              <option value="<%= j.id %>" <%= String(partida.jogador_b_id) === String(j.id) ? 'selected' : '' %>>
                <%= j.nome %><%= j.apelido ? ' (' + j.apelido + ')' : '' %>
              </option>
            <% }) %>
          </select>
          <% if (erros && erros.jogador_b_id) { %>
            <div class="invalid-feedback"><%= erros.jogador_b_id %></div>
          <% } %>
        </div>
      </div>

      <div class="row g-3 mt-0">
        <div class="col-12 p-field">
          <label class="form-label">Vencedor *</label>
          <div class="p-vencedor-grid">
            <input
              class="d-none"
              type="radio"
              name="vencedor_id"
              id="vencedor_a"
              value="<%= partida.jogador_a_id || '' %>"
              <%= String(partida.vencedor_id) && String(partida.vencedor_id) === String(partida.jogador_a_id) ? 'checked' : '' %>
            >
            <label class="p-vencedor-card <%= !(partida.jogador_a_id) ? 'p-vencedor-card--disabled' : '' %>" for="vencedor_a" id="card-vencedor-a">
              <div class="p-vencedor-card__inner">
                <div class="p-vencedor-card__avatar">A</div>
                <div class="p-vencedor-card__info">
                  <div class="p-vencedor-card__nome" id="nome-vencedor-a">Selecione o Jogador A</div>
                  <div class="p-vencedor-card__hint">Toque para marcar como vencedor</div>
                </div>
                <div class="p-vencedor-card__check" aria-hidden="true">
                  <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
              </div>
            </label>

            <div class="p-vencedor-vs">VS</div>

            <input
              class="d-none"
              type="radio"
              name="vencedor_id"
              id="vencedor_b"
              value="<%= partida.jogador_b_id || '' %>"
              <%= String(partida.vencedor_id) && String(partida.vencedor_id) === String(partida.jogador_b_id) ? 'checked' : '' %>
            >
            <label class="p-vencedor-card <%= !(partida.jogador_b_id) ? 'p-vencedor-card--disabled' : '' %>" for="vencedor_b" id="card-vencedor-b">
              <div class="p-vencedor-card__inner">
                <div class="p-vencedor-card__avatar">B</div>
                <div class="p-vencedor-card__info">
                  <div class="p-vencedor-card__nome" id="nome-vencedor-b">Selecione o Jogador B</div>
                  <div class="p-vencedor-card__hint">Toque para marcar como vencedor</div>
                </div>
                <div class="p-vencedor-card__check" aria-hidden="true">
                  <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
              </div>
            </label>
          </div>
          <div class="form-text mt-2" id="aviso-vencedor">Selecione os dois jogadores para definir o vencedor.</div>
          <% if (erros && erros.vencedor_id) { %>
            <div class="text-danger small mt-1"><%= erros.vencedor_id %></div>
          <% } %>
        </div>

        <div class="col-md-6 p-field">
          <label for="data_partida" class="form-label">Data da partida</label>
          <input
            type="datetime-local"
            class="form-control <%= erros && erros.data_partida ? 'is-invalid' : '' %>"
            id="data_partida"
            name="data_partida"
            value="<%= partida.data_partida ? partida.data_partida.replace(' ', 'T').substring(0, 16) : '' %>"
          >
          <% if (erros && erros.data_partida) { %>
            <div class="invalid-feedback"><%= erros.data_partida %></div>
          <% } %>
        </div>

        <div class="col-md-6 p-field">
          <label for="valor_aposta" class="form-label">Valor da aposta (R$)</label>
          <div class="input-group">
            <span class="input-group-text">R$</span>
            <input
              type="number"
              step="0.01"
              min="0"
              class="form-control <%= erros && erros.valor_aposta ? 'is-invalid' : '' %>"
              id="valor_aposta"
              name="valor_aposta"
              value="<%= partida.valor_aposta != null ? partida.valor_aposta : '' %>"
              placeholder="0"
            >
          </div>
          <div class="form-text mt-1">
            <% if (!partida.id && apostaPadrao > 0) { %>
              Sugerido automaticamente: <strong><%= fmtMoeda(apostaPadrao) %></strong>.
            <% } %>
            Deixe em <strong>0</strong> para partida sem aposta.
          </div>
          <% if (erros && erros.valor_aposta) { %>
            <div class="invalid-feedback"><%= erros.valor_aposta %></div>
          <% } %>
          <div class="form-check mt-2">
            <input
              class="form-check-input"
              type="checkbox"
              id="pago"
              name="pago"
              value="1"
              <%= Number(partida.pago) === 1 ? 'checked' : '' %>
            >
            <label class="form-check-label" for="pago">Aposta já quitada (paga)</label>
          </div>
        </div>
      </div>

      <div class="d-grid gap-2 d-md-flex mt-4">
        <button type="submit" class="btn p-btn p-btn--primary" <%= jogadores.length < 2 ? 'disabled' : '' %>>
          <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Salvar
        </button>
        <a href="/eventos/<%= evento.id %>" class="btn p-btn p-btn--outline">Cancelar</a>
      </div>
    </div>
  </div>
</form>

<script>
(function () {
  const a = document.getElementById('jogador_a_id')
  const b = document.getElementById('jogador_b_id')
  const radioA = document.getElementById('vencedor_a')
  const radioB = document.getElementById('vencedor_b')
  const cardA = document.getElementById('card-vencedor-a')
  const cardB = document.getElementById('card-vencedor-b')
  const nomeA = document.getElementById('nome-vencedor-a')
  const nomeB = document.getElementById('nome-vencedor-b')
  const aviso = document.getElementById('aviso-vencedor')

  if (!a || !b) return

  function nomeDoSelect(select) {
    const opt = select.options[select.selectedIndex]
    if (!opt || !opt.value) return ''
    return opt.textContent.trim()
  }

  function atualizar() {
    const na = nomeDoSelect(a)
    const nb = nomeDoSelect(b)
    const va = a.value
    const vb = b.value

    if (nomeA) nomeA.textContent = na || 'Selecione o Jogador A'
    if (nomeB) nomeB.textContent = nb || 'Selecione o Jogador B'

    if (radioA) {
      radioA.value = va || ''
      if (va) {
        radioA.disabled = false
      } else {
        radioA.disabled = true
        if (radioA.checked) radioA.checked = false
      }
    }
    if (radioB) {
      radioB.value = vb || ''
      if (vb) {
        radioB.disabled = false
      } else {
        radioB.disabled = true
        if (radioB.checked) radioB.checked = false
      }
    }

    if (cardA) {
      if (va) cardA.classList.remove('p-vencedor-card--disabled')
      else cardA.classList.add('p-vencedor-card--disabled')
    }
    if (cardB) {
      if (vb) cardB.classList.remove('p-vencedor-card--disabled')
      else cardB.classList.add('p-vencedor-card--disabled')
    }

    // Evita mesmo jogador
    const optsA = Array.from(a.options)
    const optsB = Array.from(b.options)
    optsB.forEach((o) => {
      if (!o.value) return
      o.disabled = o.value === va
    })
    optsA.forEach((o) => {
      if (!o.value) return
      o.disabled = o.value === vb
    })
    if (b.value && b.value === va) b.value = ''
    if (a.value && a.value === vb) a.value = ''

    if (aviso) {
      if (va && vb) {
        aviso.textContent = 'Toque no nome do vencedor para selecioná-lo.'
      } else {
        aviso.textContent = 'Selecione os dois jogadores para definir o vencedor.'
      }
    }

    // Se vencedor já marcado não pertence aos selecionados, limpa
    if (radioA && radioA.checked && va && radioA.value !== va) radioA.checked = false
    if (radioB && radioB.checked && vb && radioB.value !== vb) radioB.checked = false
  }

  a.addEventListener('change', atualizar)
  b.addEventListener('change', atualizar)
  atualizar()
})()
</script>

<%- include('../../partials/footer') %>
