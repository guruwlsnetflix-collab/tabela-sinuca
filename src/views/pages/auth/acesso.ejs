<%- include('../../partials/header', { title }) %>

<div class="p-login">
  <div class="p-login__head">
    <div class="p-login__emblema" aria-hidden="true"><%= tipo === 'eventos' ? '🎱' : '🏆' %></div>
    <p class="p-login__kicker mb-1">Administrar <%= rotulo %></p>
    <h1 class="p-page__title h2 mb-1"><%= item.nome %></h1>
    <p class="p-page__subtitle mb-0">Informe a senha definida na criação deste <%= rotulo %>.</p>
  </div>

  <% if (erro) { %>
    <div class="p-alert p-alert--danger mb-3" role="alert"><%= erro %></div>
  <% } %>

  <form method="POST" action="/<%= tipo %>/<%= item.id %>/acesso" class="p-card">
    <div class="p-card__body">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="p-field">
        <label for="senha" class="form-label">Senha do <%= rotulo %></label>
        <div class="p-password">
          <input
            type="password"
            class="form-control"
            id="senha"
            name="senha"
            autocomplete="current-password"
            autofocus
            required
            maxlength="200"
            placeholder="Digite a senha"
          >
          <button type="button" class="p-password__toggle" data-toggle-senha="senha"
                  aria-label="Mostrar senha" aria-pressed="false">
            <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <button type="submit" class="btn p-btn p-btn--primary w-100 mt-4">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Liberar edição
      </button>
      <a href="/<%= tipo %>/<%= item.id %>" class="btn p-btn p-btn--outline w-100 mt-2">Continuar só acompanhando</a>
    </div>
  </form>

  <ul class="p-login__help">
    <li>Com a senha você poderá <strong>incluir, alterar e excluir</strong> dados deste <%= rotulo %>.</li>
    <li>A <strong>senha mestra</strong> do sistema também é aceita aqui.</li>
    <li>Sem senha, tudo continua visível em modo somente leitura.</li>
  </ul>
</div>

<%- include('../../partials/footer') %>
