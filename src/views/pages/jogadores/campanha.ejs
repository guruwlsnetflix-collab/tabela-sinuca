<%- include('../../partials/header', { title }) %>

<div class="mb-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div class="min-w-0">
      <h1 class="p-page__title h2 mb-1"><%= campanha.jogador.nome %>
        <% if (campanha.jogador.apelido) { %><span class="text-muted fs-4">(<%= campanha.jogador.apelido %>)</span><% } %>
      </h1>
      <p class="p-page__subtitle mb-0">Campanha no evento: <%= campanha.evento.nome %></p>
    </div>
    <a href="/eventos/<%= campanha.evento.id %>" class="btn p-btn p-btn--outline flex-shrink-0">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Voltar ao evento
    </a>
  </div>
</div>

<div class="p-stats mb-4">
  <div class="p-stat">
    <div class="p-stat__head">
      <div class="p-stat__icon p-stat__icon--blue"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
    </div>
    <div class="p-stat__value"><%= campanha.resumo.jogos %></div>
    <div class="p-stat__label">Jogos</div>
  </div>
  <div class="p-stat">
    <div class="p-stat__head">
      <div class="p-stat__icon p-stat__icon--green"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
    </div>
    <div class="p-stat__value text-success"><%= campanha.resumo.vitorias %></div>
    <div class="p-stat__label">Vitórias</div>
  </div>
  <div class="p-stat">
    <div class="p-stat__head">
      <div class="p-stat__icon p-stat__icon--red"><svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></div>
    </div>
    <div class="p-stat__value text-danger"><%= campanha.resumo.derrotas %></div>
    <div class="p-stat__label">Derrotas</div>
  </div>
</div>

<h2 class="p-section__title">
  <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
  Histórico de confrontos
</h2>

<% if (campanha.partidas.length === 0) { %>
  <div class="p-empty">
    <div class="p-empty__icon">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
    </div>
    <p class="mb-0">Este jogador ainda não disputou nenhuma partida neste evento.</p>
  </div>
<% } else { %>
  <div class="p-matches p-stagger">
    <% campanha.partidas.forEach((p) => { %>
      <div class="p-match-card">
        <div class="p-match-card__meta">
          <span class="p-match-card__date">
            <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
            <%= p.data_partida %>
          </span>
          <span>
            <% if (p.vitoria) { %>
              <span class="p-badge p-badge--andamento">Vitória</span>
            <% } else { %>
              <span class="p-badge p-badge--encerrado">Derrota</span>
            <% } %>
          </span>
        </div>
        <div class="p-match-card__players">
          <div class="p-match-card__player <%= p.vitoria ? 'p-match-card__player--winner' : '' %>">
            <%= campanha.jogador.nome %>
          </div>
          <span class="p-match-card__vs">VS</span>
          <div class="p-match-card__player <%= !p.vitoria ? 'p-match-card__player--winner' : '' %>">
            <%= p.adversario %>
          </div>
        </div>
        <% if (!p.vitoria) { %>
          <p class="text-muted small mt-2 mb-0">Vencedor: <%= p.vencedor %></p>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/footer') %>
