<%- include('../../partials/header', { title }) %>

<% var editandoJogador = Boolean(jogador && jogador.id) %>
<div class="mb-4">
  <a href="/torneios/<%= torneio.id %>" class="p-link-back">← <%= torneio.nome %></a>
  <h1 class="p-page__title h2 mb-1"><%= title %></h1>
  <% if (!editandoJogador) { %>
    <p class="p-page__subtitle mb-2"><%= totalJogadores %>/<%= tamanhoChave %> jogadores inscritos</p>
    <div class="p-progress" role="progressbar" aria-valuemin="0" aria-valuemax="<%= tamanhoChave %>" aria-valuenow="<%= totalJogadores %>">
      <div class="p-progress__fill" style="width: <%= Math.round((totalJogadores / tamanhoChave) * 100) %>%"></div>
    </div>
  <% } %>
</div>

<% if (msg) { %>
  <div class="p-alert p-alert--success mb-4" role="status"><%= msg %></div>
<% } %>
<% if (erros && erros.geral) { %>
  <div class="p-alert p-alert--danger mb-4" role="alert"><%= erros.geral %></div>
<% } %>

<form method="POST"
      action="<%= jogador && jogador.id ? '/torneios/' + torneio.id + '/jogadores/' + jogador.id : '/torneios/' + torneio.id + '/jogadores' %>">
  <div class="p-card">
    <div class="p-card__body">
      <div class="p-field mb-3">
        <label for="nome" class="form-label">Nome *</label>
        <input
          type="text"
          class="form-control <%= erros && erros.nome ? 'is-invalid' : '' %>"
          id="nome"
          name="nome"
          value="<%= jogador.nome %>"
          required
          autofocus
          maxlength="120"
          placeholder="Nome do jogador"
        >
        <% if (erros && erros.nome) { %>
          <div class="invalid-feedback"><%= erros.nome %></div>
        <% } %>
      </div>

      <div class="row g-3">
        <div class="col-md-6 p-field">
          <label for="apelido" class="form-label">Apelido</label>
          <input
            type="text"
            class="form-control"
            id="apelido"
            name="apelido"
            value="<%= jogador.apelido %>"
            maxlength="60"
          >
        </div>
        <div class="col-md-6 p-field">
          <label for="telefone" class="form-label">Telefone</label>
          <input
            type="text"
            class="form-control"
            id="telefone"
            name="telefone"
            value="<%= jogador.telefone %>"
            maxlength="30"
          >
        </div>
      </div>

      <div class="d-grid gap-2 d-md-flex mt-4">
        <button type="submit" class="btn p-btn p-btn--primary"><%= editandoJogador ? 'Salvar' : 'Cadastrar e continuar' %></button>
        <a href="/torneios/<%= torneio.id %>" class="btn p-btn p-btn--outline"><%= editandoJogador ? 'Cancelar' : 'Concluir' %></a>
      </div>
    </div>
  </div>
</form>

<%- include('../../partials/footer') %>