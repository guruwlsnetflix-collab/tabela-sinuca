<%- include('../../partials/header', { title: estado.torneio.nome }) %>

<%
  var t = estado.torneio
  var podeEditar = typeof podeEditarTorneio === 'function' && podeEditarTorneio(t.id)
  var podeEditarJogadores = podeEditar && ['planejado', 'cadastro_jogadores'].indexOf(t.status) >= 0
  var torneioEmAndamento = t.status === 'em_andamento'
  var torneioAtivo = ['sorteado', 'em_andamento'].indexOf(t.status) >= 0
  var podeCorrigir = podeEditar && ['em_andamento', 'finalizado'].indexOf(t.status) >= 0
  var sorteioPronto = estado.totalJogadores === tamanhoChave
  var mesasOcupadas = estado.mesasOcupadas || 0
  var mesasDisponiveis = estado.mesasDisponiveis || 0
%>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="p-alert p-alert--success mb-4" role="status"><%= msg %></div>
<% } %>
<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="p-alert p-alert--danger mb-4" role="alert"><%= erro %></div>
<% } %>

<%- include('../../partials/modoAcesso', { tipo: 'torneios', item: t, podeAdministrar: podeEditar }) %>

<% if (t.status === 'finalizado' && t.vencedor_nome) { %>
  <div class="p-campeao mb-4" role="status">
    <div class="p-campeao__trofeu" aria-hidden="true">🏆</div>
    <div>
      <p class="p-campeao__rotulo mb-0">Campeão do torneio</p>
      <p class="p-campeao__nome mb-0"><%= t.vencedor_nome %></p>
    </div>
  </div>
<% } %>

<!-- ============ CABEÇALHO ============ -->
<section class="p-section" style="margin-top:0">
  <div class="p-hero">
    <h1 class="p-page__title h2 mb-2"><%= t.nome %></h1>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <span class="p-badge <%= t.status === 'em_andamento' ? 'p-badge--andamento' : (t.status === 'finalizado' ? 'p-badge--encerrado' : (t.status === 'cancelado' ? 'p-badge--encerrado' : 'p-badge--planejado')) %>">
        <%= t.statusLabel %>
      </span>
      <span class="badge text-bg-info"><%= t.modalidadeLabel %></span>
      <span class="badge text-bg-light"><%= t.numero_mesas %> mesa(s)</span>
      <% if (t.local) { %>
        <span class="p-hero__dates">
          <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= t.local %>
        </span>
      <% } %>
      <span class="p-hero__dates">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
        <%= formatarPeriodo(t.data_inicio, t.previsao_termino) %>
      </span>
    </div>

    <div class="d-grid gap-2 d-md-flex">
      <% if (podeEditarJogadores) { %>
        <a href="/torneios/<%= t.id %>/editar" class="p-action-btn p-action-btn--edit">
          <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
          Editar
        </a>
      <% } %>
      <a href="/torneios/<%= t.id %>/painel" target="_blank" rel="noopener" class="p-action-btn p-action-btn--report">
        <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        Painel TV / Computador
      </a>
      <a href="/torneios/<%= t.id %>/painel-tv" target="_blank" rel="noopener" class="p-action-btn p-action-btn--report">
        <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
        Painel TV / Fire Stick
      </a>
      <% if (podeEditar && t.status === 'sorteado') { %>
        <form method="POST" action="/torneios/<%= t.id %>/iniciar" class="d-grid">
          <button type="submit" class="p-action-btn p-action-btn--status">
            <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Iniciar torneio
          </button>
        </form>
      <% } %>
      <% if (podeEditar && t.status !== 'finalizado' && t.status !== 'cancelado') { %>
        <form method="POST" action="/torneios/<%= t.id %>/cancelar" class="d-grid"
              data-confirm="Cancelar este torneio?">
          <button type="submit" class="p-action-btn p-action-btn--danger-outline">
            <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
            Cancelar
          </button>
        </form>
      <% } %>
      <% if (podeEditar) { %>
        <form method="POST" action="/torneios/<%= t.id %>/excluir" class="d-grid"
              data-confirm="Excluir este torneio? Esta ação não pode ser desfeita.">
          <button type="submit" class="p-action-btn p-action-btn--danger">
            <svg class="p-action-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            Excluir
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- ============ CADASTRO E SORTEIO ============ -->
  <div class="p-card mt-4">
    <div class="p-card__body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="p-stat__icon p-stat__icon--blue flex-shrink-0" aria-hidden="true">
          <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        </div>
        <div class="min-w-0">
          <h2 class="p-card__title mb-1">Jogadores cadastrados:
            <strong class="<%= sorteioPronto ? 'text-success' : 'text-primary' %>"><%= estado.totalJogadores %>/<%= tamanhoChave %></strong>
          </h2>
          <p class="p-card__sub mb-0">
            <% if (sorteioPronto) { %>
              Todos os jogadores foram cadastrados. Pronto para o sorteio.
            <% } else { %>
              Cadastre os <%= tamanhoChave %> jogadores para liberar o sorteio.
            <% } %>
          </p>
        </div>
      </div>

      <% if (podeEditarJogadores) { %>
        <form method="GET" action="/torneios/<%= t.id %>/jogadores/novo" class="d-inline">
          <button type="submit" class="btn p-btn p-btn--primary">
            <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            Cadastrar jogador
          </button>
        </form>
      <% } %>

      <% if (podeEditar && sorteioPronto && (t.status === 'cadastro_jogadores' || t.status === 'sorteado')) { %>
        <form method="POST" action="/torneios/<%= t.id %>/sortear" class="d-inline ms-2"
              data-confirm="<%= t.status === 'sorteado' ? 'Já existe um sorteio realizado. Refazer o sorteio? A chave será redesenhada.' : 'Realizar o sorteio e formar a chave?' %>">
          <button type="submit" class="btn p-btn p-btn--glow">
            🎲 <%= t.status === 'sorteado' ? 'Refazer sorteio' : 'REALIZAR SORTEIO' %>
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Lista de jogadores -->
  <div class="p-card mt-4">
    <div class="p-card__body">
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="p-stat__icon p-stat__icon--green flex-shrink-0" aria-hidden="true">
          <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h2 class="p-card__title mb-0">Jogadores</h2>
      </div>

      <% if (estado.jogadores.length === 0) { %>
        <p class="text-muted mb-0">Nenhum jogador cadastrado ainda.</p>
      <% } else { %>
        <div class="p-players p-stagger">
          <% estado.jogadores.forEach((j) => { %>
            <div class="p-player-card p-player-card--static">
              <% if (j.posicao) { %>
                <div class="p-posicao" aria-hidden="true"><%= j.posicao %></div>
              <% } %>
              <div class="p-avatar" aria-hidden="true"><%= String(j.nome || '?').charAt(0).toUpperCase() %></div>
              <div class="p-player-card__main">
                <div class="p-player-card__name"><%= j.nome %></div>
                <% if (j.apelido) { %><div class="p-player-card__alias">@<%= j.apelido %></div><% } %>
              </div>
              <% if (podeEditarJogadores) { %>
                <a href="/torneios/<%= t.id %>/jogadores/<%= j.id %>/editar" class="p-icon-btn p-icon-btn--edit" title="Editar" aria-label="Editar <%= j.nome %>">
                  <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                </a>
                <form method="POST" action="/torneios/<%= t.id %>/jogadores/<%= j.id %>/excluir" class="d-inline"
                      data-confirm="Excluir <%= j.nome %>?">
                  <button type="submit" class="p-icon-btn p-icon-btn--danger" title="Excluir" aria-label="Excluir <%= j.nome %>">
                    <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                  </button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>

<% if (estado.confrontos.length > 0) { %>
<!-- ============ CHAVE ============ -->
<section class="p-section">
  <div class="d-flex align-items-center justify-content-between mb-3 gap-2">
    <h2 class="p-section__title mb-0">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
      Chave do torneio
    </h2>
  </div>

  <div class="p-chave">
    <% estado.fases.forEach((fase) => { %>
      <div class="p-chave__fase">
        <h3 class="p-chave__fase-title"><%= fase.label %></h3>
        <% fase.confrontos.forEach((conf) => { %>
          <div id="confronto-<%= conf.id %>" class="p-confronto <%= conf.status === 'em_andamento' ? 'p-confronto--ao-vivo' : '' %>">
            <div class="p-confronto__head">
              <span class="p-confronto__numero">Confronto <%= conf.numero %></span>
              <span class="badge <%= conf.status === 'finalizado' ? 'text-bg-success' : (conf.status === 'em_andamento' ? 'text-bg-danger' : 'text-bg-secondary') %>">
                <%= conf.status === 'em_andamento' ? '🔴 ' : '' %><%= conf.statusLabel %>
              </span>
            </div>

            <div class="p-confronto__players">
              <div class="p-confronto__player <%= conf.vencedor_id === conf.jogador_a_id ? 'p-confronto__player--winner' : '' %>">
                <span class="p-confronto__name"><%= conf.jogador_a_nome || 'A definir' %></span>
                <span class="p-confronto__score"><%= conf.placar_a %></span>
              </div>
              <div class="p-confronto__divider">
                <span class="p-confronto__vs">×</span>
                <% if (conf.status === 'em_andamento') { %>
                  <span class="p-confronto__partida">Partida <%= conf.proximaPartida %> de até <%= conf.maximoPartidas %></span>
                <% } %>
              </div>
              <div class="p-confronto__player <%= conf.vencedor_id === conf.jogador_b_id ? 'p-confronto__player--winner' : '' %>">
                <span class="p-confronto__name"><%= conf.jogador_b_nome || 'A definir' %></span>
                <span class="p-confronto__score"><%= conf.placar_b %></span>
              </div>
            </div>

            <% if (conf.status === 'finalizado') { %>
              <div class="p-confronto__result">
                <%= conf.vencedor_nome %> <%= conf.numero === 15 ? 'venceu e é o CAMPEÃO 🏆' : 'CLASSIFICADO' %>
              </div>
            <% } else if (conf.preparado && torneioEmAndamento && podeEditar) { %>
              <div class="p-confronto__actions">
                <% if (conf.status === 'aguardando') { %>
                  <form method="POST" action="/torneios/<%= t.id %>/confrontos/<%= conf.id %>/iniciar" class="d-inline">
                    <button type="submit" class="btn p-btn p-btn--outline btn-sm" <%= mesasDisponiveis > 0 ? '' : 'disabled title="Nenhuma mesa disponível. Aguarde um confronto terminar."' %>>
                      <%= mesasDisponiveis > 0 ? 'Iniciar confronto' : 'Mesas ocupadas' %>
                    </button>
                  </form>
                <% } %>
                <form method="POST" action="/torneios/<%= t.id %>/confrontos/<%= conf.id %>/partidas" class="d-inline-flex gap-2 align-items-center">
                  <span class="text-muted small">Partida <%= conf.proximaPartida %>:</span>
                  <button type="submit" name="vencedor_id" value="<%= conf.jogador_a_id %>" class="btn p-btn p-btn--primary btn-sm">
                    <%= conf.jogador_a_nome %>
                  </button>
                  <span class="text-muted">ou</span>
                  <button type="submit" name="vencedor_id" value="<%= conf.jogador_b_id %>" class="btn p-btn p-btn--primary btn-sm">
                    <%= conf.jogador_b_nome %>
                  </button>
                </form>
              </div>
            <% } %>
            <% if (podeCorrigir && conf.partidasRealizadas > 0 && conf.status !== 'finalizado') { %>
              <form method="POST" action="/torneios/<%= t.id %>/confrontos/<%= conf.id %>/desfazer" class="d-inline"
                    data-confirm="Desfazer a última partida deste confronto?">
                <button type="submit" class="btn p-btn p-btn--outline btn-sm mt-2">Desfazer última partida</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<%- include('../../partials/footer') %>