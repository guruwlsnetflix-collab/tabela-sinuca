<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="<%= telaFirestick ? 'width=1600' : 'width=device-width, initial-scale=1.0' %>">
  <meta name="theme-color" content="#0B1020">
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <title><%= estado.torneio.nome %> — Painel | Tabela de Sinuca</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/painel.css">
</head>
<body class="painel <%= telaFirestick ? 'painel--telao' : '' %>">
  <div id="painel-alvo">
  <%
    var t = estado.torneio
    var fin = t.status === 'finalizado'
    var aoVivo = estado.confrontos.filter(function (c) { return c.status === 'em_andamento' })
    var faseAtual = estado.faseAtual
    var proximoId = (faseAtual && faseAtual.confronto && faseAtual.confronto.status === 'aguardando')
      ? faseAtual.confronto.id
      : null
    // Linha inicial em grid de 16 meios: quartas/semis/final ficam entre os dois do nível anterior
    function linhaDoConfronto(numero) {
      if (numero <= 8) return numero * 2 - 1
      if (numero <= 12) return (numero - 9) * 4 + 2
      if (numero <= 14) return (numero - 13) * 8 + 4
      return 8
    }
  %>

  <header class="painel-header">
    <div class="painel-brand" aria-hidden="true">🎱</div>
    <div class="painel-header__main">
      <h1 class="painel-title"><%= t.nome %></h1>
      <div class="painel-sub">
        <% if (t.local) { %><span class="painel-chip"><%= t.local %></span><% } %>
        <span class="painel-chip"><%= formatarPeriodo(t.data_inicio, t.previsao_termino) %></span>
        <span class="painel-chip">Modalidade: <%= t.modalidadeLabel %></span>
        <span class="painel-chip">Mesas: <%= t.numero_mesas %> (<%= estado.mesasOcupadas || 0 %> em uso)</span>
      </div>
    </div>
    <div class="painel-fase">
      <span class="painel-fase__label">FASE ATUAL</span>
      <span class="painel-fase__value">
        <%- fin ? '🏆 ' + t.vencedor_nome : (faseAtual ? faseAtual.label : 'Aguardando início') %>
      </span>
    </div>
  </header>

  <% if (fin) { %>
    <div class="painel-campeao">
      <span class="painel-campeao__item" aria-hidden="true">🏆</span>
      <span class="painel-campeao__text"><%= t.vencedor_nome %> é o CAMPEÃO!</span>
      <span class="painel-campeao__item" aria-hidden="true">🏆</span>
    </div>
  <% } %>

  <main class="painel-chave">
    <svg class="painel-linhas" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none"></svg>
    <% estado.fases.forEach(function (fase) { %>
      <section class="painel-coluna">
        <h2 class="painel-coluna__titulo"><%= fase.label %></h2>
        <div class="painel-coluna__jogos">
          <% fase.confrontos.forEach(function (c) {
            var vivo = c.status === 'em_andamento'
            var proximo = !vivo && c.id === proximoId
            var vencedorA = c.vencedor_id === c.jogador_a_id
            var vencedorB = c.vencedor_id === c.jogador_b_id
            var waits = c.status === 'aguardando' && !c.preparado
          %>
            <div class="painel-confronto <%= vivo ? 'painel-confronto--vivo' : (proximo ? 'painel-confronto--proximo' : (c.status === 'finalizado' ? 'painel-confronto--fim' : '')) %>" data-numero="<%= c.numero %>" style="grid-row: <%= linhaDoConfronto(c.numero) %> / span 2;">
              <% if (vivo) { %>
                <div class="painel-vivo">
                  <span class="painel-vivo__ponto"></span>
                  <span class="painel-vivo__texto">AO VIVO</span>
                  <span class="painel-vivo__conf">Confronto <%= c.numero %></span>
                  <span class="painel-vivo__partida">Partida <%= c.proximaPartida %> de até <%= c.maximoPartidas %></span>
                </div>
              <% } %>
              <% if (proximo) { %>
                <div class="painel-proximo">PRÓXIMO</div>
              <% } %>
              <% if (waits) { %>
                <div class="painel-definir">
                  <div class="painel-jogador">
                    <span class="painel-nome"><%= c.jogador_a_nome || '—' %></span>
                    <span class="painel-placar">0</span>
                  </div>
                  <div class="painel-anda">
                    <span class="painel-vs">×</span>
                    <span class="painel-label">Definindo…</span>
                  </div>
                  <div class="painel-jogador">
                    <span class="painel-nome"><%= c.jogador_b_nome || '—' %></span>
                    <span class="painel-placar">0</span>
                  </div>
                </div>
              <% } else { %>
                <% if (c.status === 'finalizado') { %>
                  <span class="painel-classificado <%= c.numero === 15 ? 'painel-classificado--campeao' : '' %> <%= vencedorA ? 'painel-classificado--esq' : 'painel-classificado--dir' %>">
                    <%= c.numero === 15 ? '🏆 CAMPEÃO' : 'CLASSIFICADO' %>
                  </span>
                <% } %>
                <div class="painel-jogo">
                  <div class="painel-jogador <%= vencedorA ? 'painel-jogador--vencedor' : '' %>">
                    <span class="painel-nome"><%= c.jogador_a_nome || '—' %></span>
                    <span class="painel-placar"><%= c.placar_a %></span>
                  </div>
                  <div class="painel-anda">
                    <span class="painel-vs">×</span>
                    <span class="painel-conf-num">C<%= c.numero %></span>
                  </div>
                  <div class="painel-jogador <%= vencedorB ? 'painel-jogador--vencedor' : '' %>">
                    <span class="painel-nome"><%= c.jogador_b_nome || '—' %></span>
                    <span class="painel-placar"><%= c.placar_b %></span>
                  </div>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </main>

  <footer class="painel-rodape">
    <span class="painel-rodape__item">🎱 Tabela de Sinuca</span>
    <span class="painel-rodape__item">Atualização automática</span>
  </footer>
  </div>

  <div class="painel-hint" id="painel-hint">Pressione OK do controle para entrar em tela cheia</div>

  <script>
    function entrarTelaCheia() {
      var el = document.documentElement
      if (document.fullscreenElement || document.webkitFullscreenElement) return
      if (el.requestFullscreen) {
        el.requestFullscreen().catch(function () {})
      } else if (el.webkitRequestFullscreen) {
        el.webkitRequestFullscreen()
      }
    }

    function atualizarHint() {
      var hint = document.getElementById('painel-hint')
      if (!hint) return
      var ativo = document.fullscreenElement || document.webkitFullscreenElement
      hint.classList.toggle('painel-hint--oculto', Boolean(ativo))
    }

    function desenharLinhas() {
        var chave = document.querySelector('.painel-chave')
        var svg = document.querySelector('.painel-linhas')
        if (!chave || !svg) return

        var encontrados = chave.querySelectorAll('.painel-confronto[data-numero]')
        if (encontrados.length === 0) return

        var colunas = chave.querySelectorAll('.painel-coluna')
        if (colunas.length < 2) return
        var r0 = colunas[0].getBoundingClientRect()
        var r1 = colunas[1].getBoundingClientRect()
        if (r0.right > r1.left + 2) return

        var cards = {}
        for (var i = 0; i < encontrados.length; i++) {
          cards[+encontrados[i].getAttribute('data-numero')] = encontrados[i]
        }

        var br = chave.getBoundingClientRect()
        var W = br.width
        var H = br.height
        svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H)
        svg.setAttribute('width', W)
        svg.setAttribute('height', H)

        function ponto(n, lado) {
          var r = cards[n].getBoundingClientRect()
          return {
            x: (lado === 'e' ? r.left : r.right) - br.left,
            y: (r.top + r.height / 2) - br.top
          }
        }

        var pares = [
          { a: 1, b: 2, c: 9 }, { a: 3, b: 4, c: 10 },
          { a: 5, b: 6, c: 11 }, { a: 7, b: 8, c: 12 },
          { a: 9, b: 10, c: 13 }, { a: 11, b: 12, c: 14 },
          { a: 13, b: 14, c: 15 }
        ]

        var d = []
        for (var j = 0; j < pares.length; j++) {
          var p = pares[j]
          if (!cards[p.a] || !cards[p.b] || !cards[p.c]) continue
          var A = ponto(p.a, 'd')
          var B = ponto(p.b, 'd')
          var C = ponto(p.c, 'e')
          var ex = (A.x + C.x) / 2
          d.push('M ' + A.x + ' ' + A.y + ' H ' + ex + ' V ' + B.y + ' H ' + B.x)
          d.push('M ' + ex + ' ' + C.y + ' H ' + C.x)
        }

        var path = svg.querySelector('path')
        if (!path) {
          path = document.createElementNS('http://www.w3.org/2000/svg', 'path')
          svg.appendChild(path)
        }
        path.setAttribute('d', d.join(' '))
        path.setAttribute('fill', 'none')
        path.setAttribute('stroke', 'rgba(255, 255, 255, 0.42)')
        path.setAttribute('stroke-width', '3')
        path.setAttribute('stroke-linecap', 'round')
        path.setAttribute('stroke-linejoin', 'round')
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', desenharLinhas)
      } else {
        desenharLinhas()
      }
      window.addEventListener('resize', desenharLinhas)

      document.addEventListener('click', entrarTelaCheia)
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') entrarTelaCheia()
      })
      document.addEventListener('fullscreenchange', atualizarHint)
      document.addEventListener('webkitfullscreenchange', atualizarHint)

    function atualizarPainel() {
      var xhr = new XMLHttpRequest()
      xhr.open('GET', window.location.pathname + '?_=' + Date.now())
      xhr.onload = function () {
        if (xhr.status !== 200) return
        var doc = new DOMParser().parseFromString(xhr.responseText, 'text/html')
        var alvo = document.getElementById('painel-alvo')
        var novo = doc.getElementById('painel-alvo')
        if (alvo && novo) {
          alvo.innerHTML = novo.innerHTML
          desenharLinhas()
        }
      }
      xhr.send()
    }

    window.setInterval(atualizarPainel, 15000)
  </script>
</body>
</html>