<%- include('../../partials/header', { title }) %>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="p-alert p-alert--success mb-4" role="status"><%= msg %></div>
<% } %>
<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="p-alert p-alert--danger mb-4" role="alert"><%= erro %></div>
<% } %>

<div class="d-flex align-items-center justify-content-between mb-4 gap-3">
  <div class="min-w-0">
    <h1 class="p-page__title h2 mb-0">Torneios</h1>
    <p class="p-page__subtitle mb-0">Mata-mata com chave de 16 jogadores</p>
  </div>
  <a href="/torneios/novo" class="btn btn-primary p-btn p-btn--primary flex-shrink-0">
    <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
    Novo torneio
  </a>
</div>

<% if (torneios.length === 0) { %>
  <div class="p-empty">
    <div class="p-empty__icon" aria-hidden="true">🏆</div>
    <div>
      <p class="fw-semibold mb-1">Nenhum torneio criado ainda</p>
      <p class="mb-0">Crie um torneio para começar.</p>
    </div>
  </div>
<% } else { %>
  <%- include('../../partials/filtroLista', { alvo: 'lista-torneios', placeholder: 'Buscar torneio pelo nome ou local' }) %>
  <div class="p-event-list p-stagger" id="lista-torneios">
    <% torneios.forEach((t) => { %>
      <%- include('../../partials/cardTorneio', { t, torneioStatusLabel: statusLabel }) %>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/footer') %>
