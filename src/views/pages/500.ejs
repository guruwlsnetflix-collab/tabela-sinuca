<%- include('../partials/header', { title: 'Erro no servidor' }) %>

<div class="p-empty py-5">
  <div class="p-empty__icon" aria-hidden="true">
    <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
  </div>
  <h1 class="p-page__title display-4 mb-0">500</h1>
  <p class="p-page__subtitle mb-0">Ocorreu um erro no servidor.</p>
  <% if (typeof message !== 'undefined' && message) { %>
    <p class="text-muted mb-0 small"><%= message %></p>
  <% } %>
  <a href="/" class="btn p-btn p-btn--primary mt-2">Voltar ao início</a>
</div>

<%- include('../partials/footer') %>
