<%- include('../partials/header', { title: 'Tabela de Sinuca' }) %>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="alert alert-success"><%= msg %></div>
<% } %>
<% if (typeof erro !== 'undefined' && erro) { %>
  <div class="alert alert-danger"><%= erro %></div>
<% } %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <h1 class="mb-0">Eventos</h1>
  <a href="/eventos/novo" class="btn btn-primary">+ Novo evento</a>
</div>

<% if (eventos.length === 0) { %>
  <div class="alert alert-info">
    Nenhum evento cadastrado ainda. Crie o primeiro evento para começar.
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table table-cards table-striped align-middle">
      <thead>
        <tr>
          <th>Evento</th>
          <th>Início</th>
          <th>Fim</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% eventos.forEach((e) => { %>
          <tr>
            <td data-label="Evento"><strong><%= e.nome %></strong></td>
            <td data-label="Início"><%= e.data_inicio %></td>
            <td data-label="Fim"><%= e.data_fim %></td>
            <td data-label="Status"><span class="badge text-bg-secondary"><%= e.status %></span></td>
            <td data-label="Ações" class="text-end">
              <a href="/eventos/<%= e.id %>" class="btn btn-sm btn-outline-primary">Abrir</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
