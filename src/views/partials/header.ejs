<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0D1117">
  <title><%= typeof title !== 'undefined' && title !== appNome ? title + ' · ' + appNome : appNome %></title>
  <meta name="description" content="<%= typeof descricao !== 'undefined' ? descricao : 'Organize eventos e torneios de sinuca: chaveamento, partidas, ranking e painel ao vivo.' %>">
  <meta name="application-name" content="<%= appNome %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : appNome %>">
  <meta property="og:site_name" content="<%= appNome %>">
  <meta property="og:type" content="website">
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <script>
    (function () {
      try {
        var tema = localStorage.getItem('sinuca-tema')
        if (tema !== 'dark' && tema !== 'light') {
          // Mobile: tema escuro como padrão (identidade premium)
          var mobile = window.matchMedia && window.matchMedia('(max-width: 767.98px)').matches
          if (mobile) {
            tema = 'dark'
          } else {
            tema = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          }
        }
        document.documentElement.setAttribute('data-bs-theme', tema)
      } catch (e) {}
    })()
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/premium.css">
  <link rel="stylesheet" href="/css/torneio.css">
  <link rel="stylesheet" href="/css/print.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-md p-topbar sticky-top" aria-label="Navegação principal">
    <div class="container">
      <a class="navbar-brand p-brand" href="/">
        <img class="p-brand__logo" src="/img/logo.svg" alt="" width="36" height="36">
        <span><%= appNome %></span>
      </a>
      <div class="d-flex align-items-center gap-2 ms-auto ms-md-2 order-md-last">
        <button id="theme-toggle" class="btn p-theme-toggle" type="button"
                aria-label="Alternar tema claro/escuro" title="Alternar tema">
          <span id="theme-icon" aria-hidden="true">🌙</span>
        </button>
        <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Abrir menu">
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link <%= secaoAtual === 'inicio' ? 'active' : '' %>" href="/"<%- secaoAtual === 'inicio' ? ' aria-current="page"' : '' %>>Início</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= secaoAtual === 'eventos' ? 'active' : '' %>" href="/eventos"<%- secaoAtual === 'eventos' ? ' aria-current="page"' : '' %>>Eventos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= secaoAtual === 'torneios' ? 'active' : '' %>" href="/torneios"<%- secaoAtual === 'torneios' ? ' aria-current="page"' : '' %>>Torneios</a>
          </li>
          <li class="nav-item ms-md-2 mt-2 mt-md-0">
            <% if (typeof sessao !== 'undefined' && sessao) { %>
              <% var qtdAcessos = sessao.eventos.length + sessao.torneios.length %>
              <form method="POST" action="/logout" class="d-flex align-items-center gap-2">
                <span class="p-session-pill <%= sessao.mestre ? 'p-session-pill--mestre' : '' %>"
                      title="<%= sessao.mestre ? 'Acesso a todos os eventos e torneios' : 'Você administra ' + qtdAcessos + ' evento(s)/torneio(s) neste aparelho' %>">
                  <%= sessao.mestre ? 'Administrador geral' : 'Organizador · ' + qtdAcessos %>
                </span>
                <button type="submit" class="btn btn-sm p-btn p-btn--outline p-btn--sm">Sair</button>
              </form>
            <% } else { %>
              <a class="nav-link p-auth-link" href="/login">Entrar</a>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <main class="container p-page py-3 py-md-4 flex-grow-1">
