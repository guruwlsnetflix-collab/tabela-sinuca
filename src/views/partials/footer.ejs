  </main>
  <footer class="footer p-footer mt-auto py-4">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
      <div class="d-flex align-items-center gap-2">
        <img src="/img/logo.svg" alt="" width="22" height="22">
        <span class="p-footer__brand"><%= appNome %></span>
        <span class="p-footer__version">v<%= appVersao %></span>
      </div>
      <nav class="p-footer__links" aria-label="Links do rodapé">
        <a href="/eventos">Eventos</a>
        <a href="/torneios">Torneios</a>
        <% if (typeof sessao !== 'undefined' && sessao) { %>
          <span>Conectado como <%= sessao.mestre ? 'administrador geral' : 'organizador' %></span>
        <% } else { %>
          <a href="/login">Área do organizador</a>
        <% } %>
      </nav>
      <small>&copy; <%= new Date().getFullYear() %> &middot; Eventos, torneios e ranking de sinuca</small>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="/js/theme.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>
