<%
  // Faixa que deixa claro se a pessoa está administrando ou só acompanhando.
  // Espera: tipo ('eventos' | 'torneios'), item ({ id, nome }), podeAdministrar
  var rotuloAlvo = tipo === 'eventos' ? 'evento' : 'torneio'
%>
<div class="p-modebar <%= podeAdministrar ? 'p-modebar--admin' : 'p-modebar--visitante' %> d-print-none"
     data-recente="<%= JSON.stringify({ tipo: tipo, id: item.id, nome: item.nome }) %>">
  <div class="p-modebar__icon" aria-hidden="true">
    <% if (podeAdministrar) { %>
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
    <% } else { %>
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
    <% } %>
  </div>
  <div class="p-modebar__text">
    <% if (podeAdministrar) { %>
      <strong>Modo administrador</strong>
      <span>Você pode incluir, alterar e excluir dados deste <%= rotuloAlvo %>.</span>
    <% } else { %>
      <strong>Modo visitante</strong>
      <span>Acompanhe tudo em tempo real. Para editar, informe a senha do <%= rotuloAlvo %>.</span>
    <% } %>
  </div>
  <div class="p-modebar__actions">
    <button type="button" class="btn p-btn p-btn--outline p-btn--sm" data-compartilhar
            data-titulo="<%= item.nome %>" aria-label="Compartilhar link">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/></svg>
      <span class="d-none d-sm-inline">Compartilhar</span>
    </button>
    <% if (!podeAdministrar) { %>
      <a href="/<%= tipo %>/<%= item.id %>/acesso" class="btn p-btn p-btn--primary p-btn--sm">
        <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Administrar
      </a>
    <% } %>
  </div>
</div>
