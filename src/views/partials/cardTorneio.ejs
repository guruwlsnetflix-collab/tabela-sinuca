<%
  // Card de torneio usado na página inicial e na listagem de torneios.
  // Espera: t (torneio com total_jogadores), torneioStatusLabel
  var badgeTorneio = t.status === 'em_andamento' || t.status === 'sorteado'
    ? 'p-badge--andamento'
    : (t.status === 'finalizado' || t.status === 'cancelado' ? 'p-badge--encerrado' : 'p-badge--planejado')
  var grupoTorneio = ['sorteado', 'em_andamento'].indexOf(t.status) >= 0
    ? 'em_andamento'
    : (['finalizado', 'cancelado'].indexOf(t.status) >= 0 ? 'encerrado' : 'planejado')
  var pctTorneio = Math.min(100, Math.round(((t.total_jogadores || 0) / 16) * 100))
%>
<a href="/torneios/<%= t.id %>" class="p-event-card"
   data-busca="<%= (String(t.nome) + ' ' + (t.local || '')).toLowerCase() %>" data-status="<%= grupoTorneio %>">
  <div class="p-event-card__icon p-event-card__icon--gold" aria-hidden="true">🏆</div>
  <div class="p-event-card__main">
    <div class="p-event-card__name"><%= t.nome %></div>
    <div class="p-event-card__dates">
      <svg class="p-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
      <%= t.local ? t.local + ' · ' : '' %><%= formatarPeriodo(t.data_inicio, t.previsao_termino) %>
    </div>
    <div class="p-event-card__meta">
      <span class="p-badge <%= badgeTorneio %>"><%= torneioStatusLabel[t.status] || t.status %></span>
      <span class="p-meta"><%= t.numero_mesas %> mesa<%= t.numero_mesas === 1 ? '' : 's' %></span>
      <% if (t.vencedor_nome) { %>
        <span class="p-tag-campeao">🏆 <%= t.vencedor_nome %></span>
      <% } %>
      <% if (podeEditarTorneio(t.id)) { %>
        <span class="p-tag-admin" title="Você pode administrar este torneio">Admin</span>
      <% } %>
    </div>
    <% if (['planejado', 'cadastro_jogadores'].indexOf(t.status) >= 0 && typeof t.total_jogadores !== 'undefined') { %>
      <div class="p-progress mt-2" title="Jogadores inscritos">
        <div class="p-progress__fill" style="width: <%= pctTorneio %>%"></div>
      </div>
      <div class="p-meta mt-1"><%= t.total_jogadores %>/16 jogadores inscritos</div>
    <% } %>
  </div>
  <svg class="p-icon p-event-card__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
</a>
