{
  "name": "tabela-sinuca",
  "version": "2.0.0",
  "description": "Gestão de eventos e torneios de sinuca: jogadores, partidas, chaveamento mata-mata, ranking, financeiro e painel ao vivo para TV.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "node src/db/init.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "db:backup": "node src/db/backup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sinuca",
    "bilhar",
    "torneio",
    "ranking",
    "chaveamento",
    "eventos",
    "sqlite",
    "express"
  ],
  "author": "wilson souza",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.1",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guruwlsnetflix-collab/tabela-sinuca.git"
  }
}
