# Server
PORT=3000
HOST=0.0.0.0

# Caminho do arquivo SQLite (use caminho do volume na Railway: /data/sinuca.db)
DATABASE_PATH=./data/sinuca.db

# Autenticação
# Senha mestra: libera a edição de todos os dados (Eventos e Torneios).
SENHA_MAESTRA=
# Segredo opcional usado para assinar o cookie de sessão.
# Se vazio, é derivado da senha mestra.
SESSION_SECRET=
